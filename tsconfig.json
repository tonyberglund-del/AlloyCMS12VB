{
  "compilerOptions": {
    "module": "ESNext",
    "moduleResolution": "bundler",
    "esModuleInterop": true,
    "target": "ES2020",
    "strict": true,
    "skipLibCheck": true,
    "jsx": "react-jsx",
    "lib": [ "ES2020", "DOM", "DOM.Iterable" ],
    "resolveJsonModule": true,
    "allowSyntheticDefaultImports": true
  },
  "include": [ "ClientApp/src", "download-schema.cjs" ]
}
