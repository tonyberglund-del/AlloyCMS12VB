@model SearchContentModel

@{
    Layout = "~/Views/Shared/Layouts/_TwoPlusOne.cshtml";
}

<!-- React GraphQL Search Component -->
<div class="row">
    <div class="span8 search-form">
        <div class="list-group">
        <div id="react-search-root"></div>
        </div>
    </div>
</div>

<!-- Fallback original search form (for edit mode) -->
@if (Html.ViewContext.IsInEditMode())
{
    <div class="row">
        <div class="span8,search-form">
            @{
                using (Html.BeginForm(null, null, FormMethod.Post, new { @action = Model.Layout.SearchActionUrl }))
                {
                    <input type="text" tabindex="1" name="q" value="@Model.SearchedQuery" />
                    <input type="submit" tabindex="2" class="btn" value="@Html.Translate("/searchpagetemplate/searchbutton")" disabled="@(Model.SearchServiceDisabled ? "disabled" : null)" />
                }
            }
        </div>
    </div>
}

@if (Model.SearchServiceDisabled && Html.ViewContext.IsInEditMode())
{
    @await Html.PartialAsync("TemplateHint", Html.Translate("/searchpagetemplate/disabled").ToString())
}

@section Scripts {
    <script src="https://cdn.jsdelivr.net/npm/react@18/umd/react.production.min.js"></script>
    <script src="https://cdn.jsdelivr.net/npm/react-dom@18/umd/react-dom.production.min.js"></script>
    <script src="~/dist/search-results.umd.js"></script>
    <script>
        document.addEventListener('DOMContentLoaded', function() {
            console.log('SearchPage loaded');
            console.log('window.mountSearchResults:', window.mountSearchResults);
            console.log('Initial query:', '@Model.SearchedQuery');

             console.log('Initial query raw:', '@Model.SearchedQuery');
            
            if (window.mountSearchResults) {
                window.mountSearchResults('react-search-root', @Html.Raw(Json.Serialize(@Model.SearchedQuery)));
                console.log('React component mounted');
            } else {
                console.error('window.mountSearchResults is not defined - script not loaded?');
            }
        });
    </script>
}
